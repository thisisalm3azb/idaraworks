# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

.vercel

# Simulation credentials, manifest & screenshots (micro-step 006A) — NEVER commit.
# Real secrets live outside the repo (…/Desktop/IdaraWorks Private/); these patterns
# are a defensive backstop for any file accidentally written inside the repo.
simulation-accounts.txt
sim-credentials*
sim-manifest*
sim-screenshots/
.sim-secrets/
.build-*.log
.h25-shots/
.h25-shots-prod/

# H26 local walk artefacts
.h26-*
.h27-*
